# Copy to .env and fill in values
# Leave empty to use Vite dev server proxy (recommended for local dev)
VITE_API_BASE_URL=
# For production:
# VITE_API_BASE_URL=https://api.yourapp.com

# Public storefront shop slug (defaults to the seed shop)
VITE_PUBLIC_SHOP_SLUG=electronics-hub-main

# Store details shown on the public catalogue / footer (all optional).
# Anything left empty is simply hidden — never invented.
VITE_STORE_NAME=Volt Electronics
# VITE_STORE_ANNOUNCEMENT=Explore online. Find in store.
# VITE_STORE_PHONE=+91 90000 00000
# VITE_STORE_WHATSAPP=919000000000
# VITE_STORE_EMAIL=store@example.com
# VITE_STORE_ADDRESS=123 Main Road, Your City
# VITE_STORE_HOURS=Mon–Sat, 10:00–20:00
# VITE_STORE_MAPS_URL=https://maps.google.com/...

# Optional social profile links (hidden unless set)
# VITE_SOCIAL_INSTAGRAM=
# VITE_SOCIAL_FACEBOOK=
# VITE_SOCIAL_X=
# VITE_SOCIAL_YOUTUBE=
# VITE_SOCIAL_LINKEDIN=

# Optional developer credit links (credits render as plain text unless set)
# VITE_DEVELOPER_KRISH_URL=
# VITE_DEVELOPER_NETBRO_URL=
