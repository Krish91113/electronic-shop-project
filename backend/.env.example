# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ──────────────────────────────────────────────────────────────
# Database (Neon PostgreSQL)
# ──────────────────────────────────────────────────────────────
# DATABASE_URL: Pooled Neon connection string for normal application queries
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# DIRECT_URL: Direct Neon connection string for Prisma migrations (non-pooled)
DIRECT_URL=postgresql://neondb_owner:your_password@ep-your-direct.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# ──────────────────────────────────────────────────────────────
# Production Database Initialization (Safe / Idempotent)
# Time Centre Mobile & Electronics - Independent Owners
# ──────────────────────────────────────────────────────────────
# Shop 1 Owner (dedicated to Shop 1 only)
INIT_SHOP1_OWNER_EMAIL=owner1@timecentre.com
INIT_SHOP1_OWNER_PASSWORD=your_secure_password_shop1
INIT_SHOP1_OWNER_NAME="Time Centre Shop 1 Owner"
INIT_SHOP1_NAME="Time Centre - Shop 1"
INIT_SHOP1_CODE="TC1"
INIT_SHOP1_SLUG="time-centre-shop-1"

# Shop 2 Owner (dedicated to Shop 2 only)
INIT_SHOP2_OWNER_EMAIL=owner2@timecentre.com
INIT_SHOP2_OWNER_PASSWORD=your_secure_password_shop2
INIT_SHOP2_OWNER_NAME="Time Centre Shop 2 Owner"
INIT_SHOP2_NAME="Time Centre - Shop 2"
INIT_SHOP2_CODE="TC2"
INIT_SHOP2_SLUG="time-centre-shop-2"

# Optional Business Super Owner (access to both shops)
INIT_SUPER_OWNER_EMAIL=superowner@timecentre.com
INIT_SUPER_OWNER_PASSWORD=your_secure_password_super
INIT_SUPER_OWNER_NAME="Time Centre Super Owner"

# ──────────────────────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-32-char-minimum-random-secret-here
COOKIE_SECRET=your-32-char-minimum-cookie-secret-here

# ──────────────────────────────────────────────────────────────
# CORS — comma-separated list of allowed frontend origins
# ──────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ──────────────────────────────────────────────────────────────
# Cloudinary (required for image uploads)
# Create a free account at https://cloudinary.com
# ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ──────────────────────────────────────────────────────────────
# Rate limiting
# RATE_LIMIT_WINDOW_MS: sliding window in milliseconds (default: 15 minutes)
# RATE_LIMIT_MAX: max requests per window per IP
# ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
