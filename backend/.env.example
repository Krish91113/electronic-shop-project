# ──────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ──────────────────────────────────────────────────────────────
# Database (Neon PostgreSQL)
# ──────────────────────────────────────────────────────────────
# DATABASE_URL: Pooled Neon connection string for normal application queries
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# DIRECT_URL: Direct Neon connection string for Prisma migrations (non-pooled)
DIRECT_URL=postgresql://neondb_owner:your_password@ep-your-direct.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# ──────────────────────────────────────────────────────────────
# Production Database Initialization (Safe / Idempotent)
# ──────────────────────────────────────────────────────────────
INIT_OWNER_EMAIL=owner@electronics.com
INIT_OWNER_PASSWORD=your_secure_initial_owner_password
INIT_OWNER_NAME=Shop Owner

# ──────────────────────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-32-char-minimum-random-secret-here
COOKIE_SECRET=your-32-char-minimum-cookie-secret-here

# ──────────────────────────────────────────────────────────────
# CORS — comma-separated list of allowed frontend origins
# ──────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ──────────────────────────────────────────────────────────────
# Cloudinary (required for image uploads)
# Create a free account at https://cloudinary.com
# ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ──────────────────────────────────────────────────────────────
# Rate limiting
# RATE_LIMIT_WINDOW_MS: sliding window in milliseconds (default: 15 minutes)
# RATE_LIMIT_MAX: max requests per window per IP
# ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
