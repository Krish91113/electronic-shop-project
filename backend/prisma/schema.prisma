generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Shop {
  id               String            @id @default(uuid())
  name             String
  code             String            @unique
  slug             String            @unique
  contactPhone     String?
  contactEmail     String?
  address          String?
  invoicePrefix    String            @default("INV")
  invoiceFooter    String?
  logoUrl          String?
  timezone         String            @default("Asia/Kolkata")
  pricingRule      Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  memberships      ShopMembership[]
  products         Product[]
  inventories      Inventory[]
  stockMovements   StockMovement[]
  sales            Sale[]
  payments         Payment[]
  expenses         Expense[]
  taxCategories    TaxCategory[]
  invoiceSequences InvoiceSequence[]
  auditLogs        AuditLog[]
  idempotencyKeys  IdempotencyKey[]

  @@index([slug])
  @@index([code])
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  name         String?
  passwordHash String
  isActive     Boolean          @default(true)
  role         String           @default("OWNER")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  memberships  ShopMembership[]
  auditLogs    AuditLog[]

  @@index([email])
}

model ShopMembership {
  id        String   @id @default(uuid())
  userId    String
  shopId    String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([shopId])
  @@index([userId])
}

model TaxCategory {
  id        String    @id @default(uuid())
  shopId    String
  name      String
  rate      Decimal   @db.Decimal(5, 2)
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([shopId, name])
  @@index([shopId])
}

model Product {
  id                  String          @id @default(uuid())
  shopId              String
  barcode             String?
  name                String
  slug                String
  brand               String?
  model               String?
  category            String?
  description         String?
  purchaseCost        Decimal         @db.Decimal(12, 2)
  defaultSellingPrice Decimal?        @db.Decimal(12, 2)
  pricingRule         Json?
  lowStockThreshold   Int             @default(5)
  warranty            String?
  taxCategoryId       String?
  isPublished         Boolean         @default(true)
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  shop                Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  taxCategory         TaxCategory?    @relation(fields: [taxCategoryId], references: [id], onDelete: SetNull)
  inventory           Inventory?
  stockMovements      StockMovement[]
  saleItems           SaleItem[]
  images              ProductImage[]

  @@unique([shopId, barcode])
  @@unique([shopId, slug])
  @@index([shopId])
  @@index([barcode])
  @@index([name])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  publicId  String
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Inventory {
  id        String   @id @default(uuid())
  shopId    String
  productId String   @unique
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shopId, productId])
  @@index([shopId])
}

model StockMovement {
  id            String   @id @default(uuid())
  shopId        String
  productId     String
  movementType  String
  quantityDelta Int
  unitCost      Decimal  @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())

  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([productId])
  @@index([movementType])
  @@index([createdAt])
}

model InvoiceSequence {
  id         String @id @default(uuid())
  shopId     String
  year       Int
  lastNumber Int    @default(0)

  shop       Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, year])
  @@index([shopId])
}

model Sale {
  id            String     @id @default(uuid())
  shopId        String
  invoiceNumber String     @unique
  status        String     @default("COMPLETED")
  subtotal      Decimal    @db.Decimal(12, 2)
  discountTotal Decimal    @db.Decimal(12, 2) @default(0)
  taxTotal      Decimal    @db.Decimal(12, 2) @default(0)
  totalAmount   Decimal    @db.Decimal(12, 2)
  paymentStatus String     @default("PAID")
  notes         String?
  createdBy     String?
  createdAt     DateTime   @default(now())
  completedAt   DateTime?

  shop          Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items         SaleItem[]
  payments      Payment[]

  @@index([shopId])
  @@index([createdAt])
  @@index([status])
}

model SaleItem {
  id                  String   @id @default(uuid())
  saleId              String
  productId           String
  productNameSnapshot String
  barcodeSnapshot     String?
  quantity            Int
  unitSellingPrice    Decimal  @db.Decimal(12, 2)
  discountAmount      Decimal  @db.Decimal(12, 2) @default(0)
  taxCategorySnapshot String?
  taxRateSnapshot     Decimal  @db.Decimal(5, 2) @default(0)
  taxAmount           Decimal  @db.Decimal(12, 2) @default(0)
  unitCostSnapshot    Decimal  @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)

  sale                Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String   @id @default(uuid())
  shopId    String
  saleId    String
  method    String
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("SUCCESS")
  reference String?
  createdAt DateTime @default(now())

  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([saleId])
}

model Expense {
  id          String   @id @default(uuid())
  shopId      String
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  description String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([date])
}

model AuditLog {
  id         String   @id @default(uuid())
  shopId     String
  userId     String?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([action])
  @@index([createdAt])
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  shopId         String
  key            String
  endpoint       String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, key])
  @@index([shopId])
  @@index([createdAt])
}
